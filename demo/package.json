{
  "name": "demo",
  "version": "1.0.0",
  "description": "Citibank demo desktop client based on Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "test": "echo \"No test script configured\""
  },
  "build": {
    "appId": "com.citibank.demo",
    "productName": "CitibankDemo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangTf-create/AI.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/WangTf-create/AI/issues"
  },
  "homepage": "https://github.com/WangTf-create/AI#readme",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2"
  }
}
